---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import { Image } from 'astro:assets';
import gaiaLogo from '../assets/gaia-logo.svg';
import GitHubIcon from '../components/GitHubIcon.astro';
import { GITHUB_URL, NAV, WEB } from '../site-nav.mjs';

const shouldRenderSearch =
	config.pagefind ||
	config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="gaia-header">
	<div class="gaia-header__left">
		<a class="gaia-header__logo" href={WEB} aria-label="GAIA, home">
			<Image src={gaiaLogo} alt="GAIA" height={24} />
		</a>

		<nav class="gaia-header__nav" aria-label="Main navigation">
			{NAV.map((item) => (
				<a
					class="gaia-header__nav-link"
					class:list={[{ 'gaia-header__nav-link--active': item.active }]}
					href={item.href}
					aria-current={item.active ? 'page' : undefined}
				>
					{item.label}
				</a>
			))}
		</nav>
	</div>

	<div class="gaia-header__search print:hidden">
		{shouldRenderSearch && <Search />}
	</div>

	<div class="gaia-header__right print:hidden">
		<a
			class="gaia-header__github"
			href={GITHUB_URL}
			rel="noopener noreferrer"
			target="_blank"
			aria-label="GitHub"
		>
			<GitHubIcon />
			<span>GitHub</span>
		</a>
		<a class="gaia-header__cta" href={`${WEB}/get-started/`}>Get Started</a>
	</div>
</div>

<style>
	.gaia-header {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1.5rem;
		height: 100%;
		width: 100%;
		padding-inline: 1rem;
	}

	@media (min-width: 40rem) {
		.gaia-header {
			padding-inline: 2rem;
		}
	}

	.gaia-header__left {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		min-width: 0;
	}

	.gaia-header__logo {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}
	.gaia-header__logo :global(img) {
		height: 1.5rem;
		width: auto;
	}

	.gaia-header__nav {
		display: none;
		align-items: center;
		gap: 0.125rem;
	}

	.gaia-header__nav-link {
		color: var(--gaia-ink-dim, #b0aea5);
		font-family: var(--gaia-font-body);
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
		white-space: nowrap;
		text-decoration: none;
		padding: 0.375rem 0.625rem;
		border-radius: 2px;
		transition: color 150ms;
	}
	.gaia-header__nav-link:hover {
		color: var(--gaia-accent, #d97757);
	}
	.gaia-header__nav-link--active {
		color: var(--gaia-accent, #d97757);
	}

	.gaia-header__search {
		display: flex;
		justify-content: center;
		min-width: 0;
	}

	.gaia-header__right {
		display: none;
		align-items: center;
		gap: 0.5rem;
	}

	.gaia-header__github {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		color: var(--gaia-ink-dim, #b0aea5);
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
		text-decoration: none;
		padding: 0.375rem 0.625rem;
		border-radius: 2px;
		transition: color 150ms;
		white-space: nowrap;
	}
	.gaia-header__github:hover {
		color: var(--gaia-ink, #faf9f5);
	}

	.gaia-header__cta {
		display: inline-flex;
		align-items: center;
		background-color: var(--gaia-accent, #d97757);
		color: var(--gaia-canvas, #141413);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-decoration: none;
		padding: 0.4375rem 0.875rem;
		border-radius: 2px;
		white-space: nowrap;
		transition: background-color 150ms;
	}
	.gaia-header__cta:hover {
		background-color: var(--gaia-accent-2, #c96442);
	}

	@media (min-width: 50rem) {
		.gaia-header__nav,
		.gaia-header__right {
			display: flex;
		}
	}

	/* Hand the search element a sensible width without fighting Starlight. */
	.gaia-header__search :global(site-search) {
		width: 100%;
		max-width: 22rem;
		margin-inline: auto;
	}
</style>
